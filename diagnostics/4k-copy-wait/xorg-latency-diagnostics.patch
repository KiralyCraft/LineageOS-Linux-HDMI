+/* SPDX-License-Identifier: MIT
+ * Opt-in wall-clock counters. No GPU query, fence, wait, or per-operation I/O.
+ */
+#ifndef HDMI_LATENCY_H
+#define HDMI_LATENCY_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#define HDMI_LATENCY_BINS 256
+struct hdmi_latency_hist {
+    uint64_t bins[HDMI_LATENCY_BINS], n, sum, max;
+};
+static inline int hdmi_latency_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("HDMI_LOS_LATENCY_STATS");
+        enabled = value && !strcmp(value, "1");
+    }
+    return enabled;
+}
+static inline uint64_t hdmi_latency_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+static inline void hdmi_latency_add(struct hdmi_latency_hist *h, uint64_t us)
+{
+    unsigned b = us / 250 < HDMI_LATENCY_BINS ? us / 250 : HDMI_LATENCY_BINS - 1;
+    h->bins[b]++; h->n++; h->sum += us;
+    if (us > h->max) h->max = us;
+}
+/* Quantiles are bucket upper bounds (250 us bins), not exact samples. */
+static inline uint64_t hdmi_latency_quantile(const struct hdmi_latency_hist *h,
+                                            unsigned percent)
+{
+    uint64_t n = 0, target = (h->n * percent + 99) / 100;
+    unsigned i;
+    if (!target) return 0;
+    for (i = 0; i < HDMI_LATENCY_BINS; i++) {
+        n += h->bins[i];
+        if (n >= target)
+            return i == HDMI_LATENCY_BINS - 1 ? h->max : (i + 1) * 250;
+    }
+    return h->max;
+}
+struct hdmi_tearfree_latency {
+    /* copy submission, finish, total copy, queue, in-flight, callback gap,
+     * first observed damage to copy, callback minus reported UST */
+    struct hdmi_latency_hist hist[8];
+    uint64_t rects, pixels, copies, updates, pending_skips, failures;
+    uint64_t repeated_msc, backwards_msc, future_ust;
+    uint64_t report_us, pending_us, last_callback_us, last_msc, first_damage_us;
+};
+#endif
