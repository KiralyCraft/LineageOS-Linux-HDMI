From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KiralyCraft <alexucu@gmail.com>
Date: Tue, 1 Sep 2026 12:10:00 +0300
Subject: [PATCH] sdm: do not gate leases on unused active flag

HWDeviceDRM::active_ is initialized false but is never updated in this display
tree.  Requiring it during preparation therefore rejects every otherwise valid
external display before the DRM plane lookup.  The corresponding check during
creation is also inert and does not prove that pause completed.

The composer-side HWCDisplay checks already require an on, unpaused display
before preparation and a successfully paused display before creation.  Keep
those authoritative lifecycle gates and remove the unused DAL flag checks.
---
 sdm/libs/dal/hw_device_drm.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/sdm/libs/dal/hw_device_drm.cpp b/sdm/libs/dal/hw_device_drm.cpp
index eb60093..2d4a1db 100644
--- a/sdm/libs/dal/hw_device_drm.cpp
+++ b/sdm/libs/dal/hw_device_drm.cpp
@@ -2623,4 +2623,5 @@
 DisplayError HWDeviceDRM::PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
-  if (!lease || disp_type_ != DRMDisplayType::TV || dev_fd_ < 0 || !drmIsMaster(dev_fd_) ||
-      !active_) {
+  // HWCDisplay has already required an on, unpaused pluggable display.  The
+  // DAL active_ member is not maintained in this tree and remains false.
+  if (!lease || disp_type_ != DRMDisplayType::TV || dev_fd_ < 0 || !drmIsMaster(dev_fd_)) {
     return kErrorNotSupported;
@@ -2681,3 +2682,3 @@
   ExternalDisplayLeaseState &state = state_it->second;
-  if (!state.prepared || state.active || state.plane_id == 0 || active_) {
+  if (!state.prepared || state.active || state.plane_id == 0) {
     return kErrorParameters;
