 sdm/libs/dal/hw_device_drm.cpp | 140 ++++++++++++++++++++++++---------
 1 file changed, 103 insertions(+), 37 deletions(-)

diff --git a/sdm/libs/dal/hw_device_drm.cpp b/sdm/libs/dal/hw_device_drm.cpp
index 78c12ee..5a80bbb 100644
--- a/sdm/libs/dal/hw_device_drm.cpp
+++ b/sdm/libs/dal/hw_device_drm.cpp
@@ -126,6 +126,7 @@ namespace {

 struct ExternalDisplayLeaseState {
   uint32_t plane_id = 0;
+  uint32_t cursor_plane_id = 0;
   uint32_t lessee_id = 0;
   bool prepared = false;
   bool active = false;
@@ -218,6 +219,76 @@ DisplayError GetFixedPrimaryPlane(int fd, uint32_t crtc_id, uint32_t *crtc_index
   return kErrorNone;
 }

+DisplayError GetCursorOverlayPlane(int fd, uint32_t crtc_index, uint32_t crtc_id,
+                                   uint32_t *plane_id) {
+  if (!plane_id || crtc_index >= 32) {
+    return kErrorParameters;
+  }
+  *plane_id = 0;
+
+  drmModePlaneResPtr resources = drmModeGetPlaneResources(fd);
+  if (!resources) {
+    DLOGE("hdmi-los: cannot enumerate cursor-overlay candidates: %s", strerror(errno));
+    return kErrorHardware;
+  }
+
+  uint32_t idle_candidate = 0;
+  uint64_t idle_zpos = 0;
+  uint32_t external_candidate = 0;
+  uint64_t external_zpos = 0;
+  for (uint32_t i = 0; i < resources->count_planes; ++i) {
+    drmModePlanePtr plane = drmModeGetPlane(fd, resources->planes[i]);
+    if (!plane) {
+      DLOGE("hdmi-los: cannot inspect cursor-overlay candidate %u: %s",
+            resources->planes[i], strerror(errno));
+      drmModeFreePlaneResources(resources);
+      return kErrorHardware;
+    }
+
+    uint64_t type = UINT64_MAX;
+    uint64_t zpos = 0;
+    const bool is_overlay =
+        GetDrmProperty(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE, "type", nullptr, &type) &&
+        type == DRM_PLANE_TYPE_OVERLAY;
+    const bool has_zpos =
+        GetDrmProperty(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE, "zpos", nullptr, &zpos);
+    bool has_argb8888 = false;
+    for (uint32_t format = 0; format < plane->count_formats; ++format) {
+      if (plane->formats[format] == DRM_FORMAT_ARGB8888) {
+        has_argb8888 = true;
+        break;
+      }
+    }
+    const bool compatible = (plane->possible_crtcs & (1U << crtc_index)) != 0;
+    const bool belongs_to_external = plane->crtc_id == crtc_id;
+    const bool idle = plane->crtc_id == 0 && plane->fb_id == 0;
+    if (is_overlay && has_zpos && has_argb8888 && compatible &&
+        (belongs_to_external || idle)) {
+      uint32_t *candidate = belongs_to_external ? &external_candidate : &idle_candidate;
+      uint64_t *candidate_zpos = belongs_to_external ? &external_zpos : &idle_zpos;
+      if (*candidate == 0 || zpos > *candidate_zpos ||
+          (zpos == *candidate_zpos && plane->plane_id < *candidate)) {
+        *candidate = plane->plane_id;
+        *candidate_zpos = zpos;
+      }
+    }
+    drmModeFreePlane(plane);
+  }
+  drmModeFreePlaneResources(resources);
+
+  *plane_id = external_candidate ? external_candidate : idle_candidate;
+  if (!*plane_id) {
+    DLOGW("hdmi-los: no idle ARGB8888 overlay is compatible with external CRTC %u",
+          crtc_id);
+    return kErrorNotSupported;
+  }
+  DLOGI("hdmi-los: selected cursor overlay %u for external CRTC %u (zpos=%" PRIu64
+        " source=%s)", *plane_id, crtc_id,
+        external_candidate ? external_zpos : idle_zpos,
+        external_candidate ? "external" : "idle");
+  return kErrorNone;
+}
+
 struct PlanePropertyReset {
   const char *name;
   uint64_t value;
@@ -232,15 +303,16 @@ struct PlaneSanitizeState {
   std::vector<PlanePropertyReset> resets;
 };

-DisplayError SanitizeExternalPlanesForLease(int fd, uint32_t leased_plane_id,
-                                            uint32_t crtc_id) {
+DisplayError SanitizeExternalPlanesForLease(int fd, uint32_t primary_plane_id,
