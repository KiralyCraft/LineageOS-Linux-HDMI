From eb2fed06612c1e1c5d2bff043e5ee837274750e2 Mon Sep 17 00:00:00 2001
From: hdmi-los-builder <hdmi-los@localhost>
Date: Thu, 3 Sep 2026 13:26:33 +0300
Subject: [PATCH] composer: serialize the final DRM lease handoff

The prepared fixed-primary plane can be reassigned by another SurfaceFlinger command batch between the staged pause and create calls.  The per-display sequence lock cannot close that cross-display window.

Use Qualcomm composer command_seq_mutex_ for the final CREATE phase, taking it before the HDMI lease-state mutex to preserve the existing lock order.  Re-resolve the CRTC-indexed fixed primary plane under that serialization immediately before drmModeCreateLease(), and report its current CRTC assignment when the handoff cannot proceed safely.
---
 composer/hwc_session.cpp       |   7 ++
 sdm/libs/dal/hw_device_drm.cpp | 141 ++++++++++++++++++++-------------
 2 files changed, 92 insertions(+), 56 deletions(-)

diff --git a/composer/hwc_session.cpp b/composer/hwc_session.cpp
index ea018bc..1491ade 100644
--- a/composer/hwc_session.cpp
+++ b/composer/hwc_session.cpp
@@ -445,6 +445,13 @@ void HWCSession::GetHdmiLeaseStatus(hdmi_los_message *status) {
 
 int HWCSession::AcquireHdmiLease(uint32_t phase, hdmi_los_message *status, int *lease_fd) {
   if (!status || !lease_fd) return HDMI_LOS_ERR_PROTOCOL;
+  // SurfaceFlinger serializes every command batch with this mutex.  Take it
+  // before the lease-state mutex for the final handoff so no display can
+  // reassign the fixed primary plane between its refresh and drmModeCreateLease().
+  // ReleaseHdmiLease may run from inside a SurfaceFlinger command batch, so the
+  // order must remain command_seq_mutex_ -> hdmi_lease_mutex_.
+  std::unique_lock<std::mutex> command_lock(command_seq_mutex_, std::defer_lock);
+  if (phase == HDMI_LOS_ACQUIRE_CREATE) command_lock.lock();
   std::lock_guard<std::mutex> lease_lock(hdmi_lease_mutex_);
   *lease_fd = -1;
   auto fill_status = [&](int result) {
diff --git a/sdm/libs/dal/hw_device_drm.cpp b/sdm/libs/dal/hw_device_drm.cpp
index 1532a0e..006140f 100644
--- a/sdm/libs/dal/hw_device_drm.cpp
+++ b/sdm/libs/dal/hw_device_drm.cpp
@@ -155,6 +155,69 @@ bool GetDrmProperty(int fd, uint32_t object_id, uint32_t object_type, const char
   return found;
 }
 
+DisplayError GetFixedPrimaryPlane(int fd, uint32_t crtc_id, uint32_t *crtc_index,
+                                  uint32_t *plane_id, uint32_t *plane_crtc_id) {
+  if (!crtc_index || !plane_id || !plane_crtc_id) {
+    return kErrorParameters;
+  }
+
+  *crtc_index = UINT32_MAX;
+  *plane_id = 0;
+  *plane_crtc_id = 0;
+  drmModeResPtr drm_resources = drmModeGetResources(fd);
+  if (!drm_resources) {
+    DLOGE("hdmi-los: cannot enumerate DRM resources: %s", strerror(errno));
+    return kErrorHardware;
+  }
+
+  for (int i = 0; i < drm_resources->count_crtcs; ++i) {
+    if (drm_resources->crtcs[i] == crtc_id) {
+      *crtc_index = static_cast<uint32_t>(i);
+      break;
+    }
+  }
+  if (*crtc_index >= 32) {
+    drmModeFreeResources(drm_resources);
+    DLOGE("hdmi-los: external CRTC %u has no usable DRM resource index", crtc_id);
+    return kErrorResources;
+  }
+
+  drmModePlaneResPtr plane_resources = drmModeGetPlaneResources(fd);
+  if (!plane_resources) {
+    drmModeFreeResources(drm_resources);
+    DLOGE("hdmi-los: cannot enumerate DRM planes: %s", strerror(errno));
+    return kErrorHardware;
+  }
+
+  uint32_t primary_index = 0;
+  for (uint32_t i = 0; i < plane_resources->count_planes; ++i) {
+    drmModePlanePtr plane = drmModeGetPlane(fd, plane_resources->planes[i]);
+    uint64_t type = UINT64_MAX;
+    const bool is_primary =
+        plane && GetDrmProperty(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE, "type", nullptr,
+                                &type) &&
+        type == DRM_PLANE_TYPE_PRIMARY;
+    if (is_primary) {
+      if (primary_index == *crtc_index &&
+          (plane->possible_crtcs & (1U << *crtc_index)) != 0) {
+        *plane_id = plane->plane_id;
+        *plane_crtc_id = plane->crtc_id;
+      }
+      ++primary_index;
+    }
+    if (plane) drmModeFreePlane(plane);
+    if (*plane_id) break;
+  }
+  drmModeFreePlaneResources(plane_resources);
+  drmModeFreeResources(drm_resources);
+
+  if (!*plane_id) {
+    DLOGE("hdmi-los: external CRTC %u has no fixed primary plane", crtc_id);
+    return kErrorResources;
+  }
+  return kErrorNone;
+}
+
 }  // namespace
 
 std::atomic<uint32_t> HWDeviceDRM::hw_dest_scaler_blocks_used_(0);
@@ -2634,57 +2697,12 @@ DisplayError HWDeviceDRM::PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
     return kErrorNotSupported;
   }
 
-  drmModeResPtr drm_resources = drmModeGetResources(dev_fd_);
-  if (!drm_resources) {
-    DLOGE("hdmi-los: cannot enumerate DRM resources: %s", strerror(errno));
-    return kErrorHardware;
-  }
-
   uint32_t crtc_index = UINT32_MAX;
-  for (int i = 0; i < drm_resources->count_crtcs; ++i) {
-    if (drm_resources->crtcs[i] == token_.crtc_id) {
-      crtc_index = static_cast<uint32_t>(i);
-      break;
-    }
-  }
-  if (crtc_index >= 32) {
-    drmModeFreeResources(drm_resources);
-    DLOGE("hdmi-los: external CRTC %u has no usable DRM resource index", token_.crtc_id);
-    return kErrorResources;
-  }
-
-  drmModePlaneResPtr resources = drmModeGetPlaneResources(dev_fd_);
-  if (!resources) {
-    drmModeFreeResources(drm_resources);
-    DLOGE("hdmi-los: cannot enumerate DRM planes: %s", strerror(errno));
-    return kErrorHardware;
-  }
-
   uint32_t selected = 0;
-  uint32_t primary_index = 0;
-  for (uint32_t i = 0; i < resources->count_planes; ++i) {
-    drmModePlanePtr plane = drmModeGetPlane(dev_fd_, resources->planes[i]);
-    uint64_t type = UINT64_MAX;
-    const bool is_primary =
-        plane && GetDrmProperty(dev_fd_, plane->plane_id, DRM_MODE_OBJECT_PLANE, "type",
-                                nullptr, &type) &&
-        type == DRM_PLANE_TYPE_PRIMARY;
-    if (is_primary) {
-      if (primary_index == crtc_index &&
-          (plane->possible_crtcs & (1U << crtc_index)) != 0) {
-        selected = plane->plane_id;
-      }
-      ++primary_index;
-    }
-    if (plane) drmModeFreePlane(plane);
-    if (selected) break;
-  }
-  drmModeFreePlaneResources(resources);
-  drmModeFreeResources(drm_resources);
-  if (!selected) {
-    DLOGE("hdmi-los: external CRTC %u has no fixed primary plane", token_.crtc_id);
-    return kErrorResources;
-  }
+  uint32_t plane_crtc_id = 0;
+  DisplayError error =
+      GetFixedPrimaryPlane(dev_fd_, token_.crtc_id, &crtc_index, &selected, &plane_crtc_id);
+  if (error != kErrorNone) return error;
 
   ExternalDisplayLeaseState &state = external_display_leases[this];
   state.plane_id = selected;
@@ -2692,8 +2710,9 @@ DisplayError HWDeviceDRM::PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
   lease->connector_id = token_.conn_id;
   lease->crtc_id = token_.crtc_id;
   lease->plane_id = selected;
-  DLOGI("hdmi-los: prepared connector=%u crtc=%u crtc-index=%u fixed-primary-plane=%u",
-        token_.conn_id, token_.crtc_id, crtc_index, selected);
+  DLOGI("hdmi-los: prepared connector=%u crtc=%u crtc-index=%u fixed-primary-plane=%u "
+        "assigned-crtc=%u",
+        token_.conn_id, token_.crtc_id, crtc_index, selected, plane_crtc_id);
   return kErrorNone;
 }
 
@@ -2717,13 +2736,23 @@ DisplayError HWDeviceDRM::CreateExternalDisplayLease(DisplayLeaseInfo *lease) {
     return kErrorDeviceRemoved;
   }
 
-  drmModePlanePtr plane = drmModeGetPlane(dev_fd_, state.plane_id);
-  if (!plane || (plane->crtc_id != 0 && plane->crtc_id != token_.crtc_id)) {
-    if (plane) drmModeFreePlane(plane);
-    DLOGE("hdmi-los: prepared plane was reassigned before lease creation");
+  uint32_t crtc_index = UINT32_MAX;
+  uint32_t selected = 0;
+  uint32_t plane_crtc_id = 0;
+  DisplayError error =
+      GetFixedPrimaryPlane(dev_fd_, token_.crtc_id, &crtc_index, &selected, &plane_crtc_id);
+  if (error != kErrorNone) return error;
+  if (state.plane_id != selected) {
+    DLOGI("hdmi-los: refreshed fixed primary plane %u -> %u at final handoff",
+          state.plane_id, selected);
+    state.plane_id = selected;
+  }
+  if (plane_crtc_id != 0 && plane_crtc_id != token_.crtc_id) {
+    DLOGE("hdmi-los: fixed primary plane %u belongs to CRTC %u at final handoff "
+          "(external CRTC %u)",
+          state.plane_id, plane_crtc_id, token_.crtc_id);
     return kErrorResources;
   }
-  drmModeFreePlane(plane);
 
   uint32_t objects[] = {token_.conn_id, token_.crtc_id, state.plane_id};
   uint32_t lessee_id = 0;
