+DisplayError PrepareExternalDisplayLease(HWInterface *hw_intf, DisplayLeaseInfo *lease) {
+  if (!hw_intf) {
+    return kErrorParameters;
+  }
+  return static_cast<HWDeviceDRM *>(hw_intf)->PrepareExternalDisplayLease(lease);
+}
+
+DisplayError CreateExternalDisplayLease(HWInterface *hw_intf, DisplayLeaseInfo *lease) {
+  if (!hw_intf) {
+    return kErrorParameters;
+  }
+  return static_cast<HWDeviceDRM *>(hw_intf)->CreateExternalDisplayLease(lease);
+}
+
+DisplayError RevokeExternalDisplayLease(HWInterface *hw_intf) {
+  if (!hw_intf) {
+    return kErrorParameters;
+  }
