@@ -0,0 +1,47 @@
+#ifndef HDMI_LEASE_SERVER_H
+#define HDMI_LEASE_SERVER_H
+
+#include <atomic>
+#include <memory>
+#include <thread>
+
+#include "hdmi_los_protocol.h"
+
+namespace sdm {
+
+class HdmiLeaseController {
+ public:
+  virtual int AcquireHdmiLease(hdmi_los_message *status, int *lease_fd) = 0;
+  virtual int ReleaseHdmiLease(const char *reason) = 0;
+  virtual void GetHdmiLeaseStatus(hdmi_los_message *status) = 0;
+
+ protected:
+  virtual ~HdmiLeaseController() = default;
+};
+
+class HdmiLeaseServer {
+ public:
+  explicit HdmiLeaseServer(HdmiLeaseController *controller);
+  ~HdmiLeaseServer();
+
+  int Start();
+  void Stop();
+
+ private:
+  void ThreadMain();
+  bool HandleRequest(int client_fd, const hdmi_los_message &request);
+  bool SendResponse(int client_fd, const hdmi_los_message &response, int fd);
+  static int64_t MonotonicMs();
+
+  HdmiLeaseController *controller_ = nullptr;
+  std::atomic<bool> running_ = false;
+  std::thread thread_;
+  int listen_fd_ = -1;
+  int wake_read_fd_ = -1;
+  int wake_write_fd_ = -1;
+  int64_t deadline_ms_ = 0;
+};
+
+}  // namespace sdm
+
+#endif
diff --git a/composer/hdmi_los_protocol.h b/composer/hdmi_los_protocol.h
new file mode 100644
index 0000000..0a6de4b
--- /dev/null
+++ b/composer/hdmi_los_protocol.h
@@ -0,0 +1,58 @@
+#ifndef HDMI_LOS_PROTOCOL_H
+#define HDMI_LOS_PROTOCOL_H
+
+#include <stdint.h>
+
+#define HDMI_LOS_MAGIC 0x48444d49u
+#define HDMI_LOS_VERSION 1u
+#define HDMI_LOS_MESSAGE_SIZE 160u
+#define HDMI_LOS_COMPOSER_SOCKET "hdmi-los-composer-v1"
+
+enum hdmi_los_opcode {
+  HDMI_LOS_OP_STATUS = 1,
+  HDMI_LOS_OP_ACQUIRE = 2,
+  HDMI_LOS_OP_RELEASE = 3,
+  HDMI_LOS_OP_PING = 4,
+  HDMI_LOS_OP_RESPONSE = 0x8000,
+};
+
+enum hdmi_los_state {
+  HDMI_LOS_STATE_ANDROID = 0,
+  HDMI_LOS_STATE_DRAINING = 1,
+  HDMI_LOS_STATE_LEASED = 2,
+  HDMI_LOS_STATE_RESTORING = 3,
+  HDMI_LOS_STATE_UNAVAILABLE = 4,
+  HDMI_LOS_STATE_ERROR = 5,
+};
+
+enum hdmi_los_status {
+  HDMI_LOS_OK = 0,
+  HDMI_LOS_ERR_PROTOCOL = -1,
+  HDMI_LOS_ERR_BUSY = -2,
+  HDMI_LOS_ERR_UNAVAILABLE = -3,
+  HDMI_LOS_ERR_PERMISSION = -4,
+  HDMI_LOS_ERR_STATE = -5,
+  HDMI_LOS_ERR_IO = -6,
+  HDMI_LOS_ERR_TIMEOUT = -7,
+};
+
+struct hdmi_los_message {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t opcode;
+  uint32_t request_id;
+  int32_t status;
+  uint32_t state;
+  uint32_t remaining_seconds;
+  uint32_t connector_id;
+  uint32_t crtc_id;
+  uint32_t plane_id;
+  uint32_t lessee_id;
+  uint32_t flags;
+  char detail[116];
+};
+
+static_assert(sizeof(hdmi_los_message) == HDMI_LOS_MESSAGE_SIZE,
+              "hdmi_los_message ABI changed");
+
+#endif
