diff --git a/composer/hdmi_lease_server.cpp b/composer/hdmi_lease_server.cpp
new file mode 100644
index 0000000..11aa622
--- /dev/null
+++ b/composer/hdmi_lease_server.cpp
@@ -0,0 +1,241 @@
+#include "hdmi_lease_server.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <log/log.h>
+#include <poll.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <algorithm>
+
+namespace sdm {
+namespace {
+
+constexpr int kComposerFailsafeSeconds = 65;
+
+socklen_t AbstractAddress(sockaddr_un *address, const char *name) {
+  memset(address, 0, sizeof(*address));
+  address->sun_family = AF_UNIX;
+  size_t length = std::min(strlen(name), sizeof(address->sun_path) - 2);
+  memcpy(address->sun_path + 1, name, length);
+  return static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + length);
+}
+
+void FillError(hdmi_los_message *response, int status, const char *detail) {
+  response->status = status;
+  response->state = HDMI_LOS_STATE_ERROR;
+  snprintf(response->detail, sizeof(response->detail), "%s", detail);
+}
+
+}  // namespace
+
+HdmiLeaseServer::HdmiLeaseServer(HdmiLeaseController *controller) : controller_(controller) {}
+
+HdmiLeaseServer::~HdmiLeaseServer() {
+  Stop();
+}
+
+int HdmiLeaseServer::Start() {
+  if (running_.exchange(true)) {
+    return 0;
+  }
+
+  listen_fd_ = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+  if (listen_fd_ < 0) {
+    ALOGE("hdmi-los: cannot create composer socket: %s", strerror(errno));
+    running_ = false;
+    return -errno;
+  }
+
+  sockaddr_un address = {};
+  socklen_t address_length = AbstractAddress(&address, HDMI_LOS_COMPOSER_SOCKET);
+  if (bind(listen_fd_, reinterpret_cast<sockaddr *>(&address), address_length) < 0 ||
+      listen(listen_fd_, 1) < 0) {
+    int error = errno;
+    ALOGE("hdmi-los: cannot bind composer socket: %s", strerror(error));
+    close(listen_fd_);
+    listen_fd_ = -1;
+    running_ = false;
+    return -error;
+  }
+
+  int wake[2] = {-1, -1};
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, wake) < 0) {
+    int error = errno;
+    close(listen_fd_);
+    listen_fd_ = -1;
+    running_ = false;
+    return -error;
+  }
+  wake_read_fd_ = wake[0];
+  wake_write_fd_ = wake[1];
+  thread_ = std::thread(&HdmiLeaseServer::ThreadMain, this);
+  ALOGI("hdmi-los: composer lease endpoint ready");
+  return 0;
+}
+
+void HdmiLeaseServer::Stop() {
+  if (!running_.exchange(false)) {
+    return;
+  }
+  if (wake_write_fd_ >= 0) {
+    char byte = 1;
+    (void)write(wake_write_fd_, &byte, sizeof(byte));
+  }
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  if (wake_read_fd_ >= 0) close(wake_read_fd_);
+  if (wake_write_fd_ >= 0) close(wake_write_fd_);
+  if (listen_fd_ >= 0) close(listen_fd_);
+  wake_read_fd_ = wake_write_fd_ = listen_fd_ = -1;
+}
+
+int64_t HdmiLeaseServer::MonotonicMs() {
+  timespec now = {};
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return static_cast<int64_t>(now.tv_sec) * 1000 + now.tv_nsec / 1000000;
+}
+
+bool HdmiLeaseServer::SendResponse(int client_fd, const hdmi_los_message &response, int fd) {
+  iovec iov = {const_cast<hdmi_los_message *>(&response), sizeof(response)};
+  msghdr message = {};
+  message.msg_iov = &iov;
+  message.msg_iovlen = 1;
+  char control[CMSG_SPACE(sizeof(int))] = {};
+  if (fd >= 0) {
+    message.msg_control = control;
+    message.msg_controllen = sizeof(control);
+    cmsghdr *cmsg = CMSG_FIRSTHDR(&message);
+    cmsg->cmsg_level = SOL_SOCKET;
+    cmsg->cmsg_type = SCM_RIGHTS;
+    cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+    memcpy(CMSG_DATA(cmsg), &fd, sizeof(fd));
+  }
+  ssize_t sent;
+  do {
+    sent = sendmsg(client_fd, &message, MSG_NOSIGNAL);
+  } while (sent < 0 && errno == EINTR);
+  return sent == static_cast<ssize_t>(sizeof(response));
+}
+
+bool HdmiLeaseServer::HandleRequest(int client_fd, const hdmi_los_message &request) {
+  hdmi_los_message response = {};
+  response.magic = HDMI_LOS_MAGIC;
+  response.version = HDMI_LOS_VERSION;
+  response.opcode = request.opcode | HDMI_LOS_OP_RESPONSE;
+  response.request_id = request.request_id;
+
+  if (request.magic != HDMI_LOS_MAGIC || request.version != HDMI_LOS_VERSION) {
+    FillError(&response, HDMI_LOS_ERR_PROTOCOL, "protocol mismatch");
+    return SendResponse(client_fd, response, -1);
+  }
+
+  int lease_fd = -1;
+  switch (request.opcode) {
+    case HDMI_LOS_OP_STATUS:
+    case HDMI_LOS_OP_PING:
+      controller_->GetHdmiLeaseStatus(&response);
+      break;
+    case HDMI_LOS_OP_ACQUIRE:
+      response.status = controller_->AcquireHdmiLease(&response, &lease_fd);
+      if (response.status == HDMI_LOS_OK) {
+        deadline_ms_ = MonotonicMs() + kComposerFailsafeSeconds * 1000;
+      }
+      break;
+    case HDMI_LOS_OP_RELEASE:
+      response.status = controller_->ReleaseHdmiLease("broker request");
+      deadline_ms_ = 0;
+      controller_->GetHdmiLeaseStatus(&response);
+      break;
+    default:
+      FillError(&response, HDMI_LOS_ERR_PROTOCOL, "unknown opcode");
+      break;
+  }
+
+  bool delivered = SendResponse(client_fd, response, lease_fd);
+  if (lease_fd >= 0) close(lease_fd);
+  if (!delivered && request.opcode == HDMI_LOS_OP_ACQUIRE && response.status == HDMI_LOS_OK) {
+    controller_->ReleaseHdmiLease("lease fd delivery failed");
+    deadline_ms_ = 0;
+  }
+  return delivered;
+}
+
+void HdmiLeaseServer::ThreadMain() {
+  int client_fd = -1;
+  while (running_) {
+    pollfd fds[3] = {
+        {listen_fd_, POLLIN, 0},
+        {wake_read_fd_, POLLIN, 0},
+        {client_fd, static_cast<short>(POLLIN | POLLERR | POLLHUP), 0},
+    };
+    int timeout = 1000;
+    if (deadline_ms_ > 0) {
+      timeout = static_cast<int>(std::max<int64_t>(0, std::min<int64_t>(1000,
+                                            deadline_ms_ - MonotonicMs())));
+    }
+    int result;
+    do {
+      result = poll(fds, client_fd >= 0 ? 3 : 2, timeout);
+    } while (result < 0 && errno == EINTR);
+    if (!running_ || (result > 0 && (fds[1].revents & POLLIN))) break;
+
+    if (deadline_ms_ > 0 && MonotonicMs() >= deadline_ms_) {
+      ALOGW("hdmi-los: composer failsafe expired");
+      controller_->ReleaseHdmiLease("composer 65 second failsafe");
+      deadline_ms_ = 0;
+    }
+
+    if (result > 0 && (fds[0].revents & POLLIN)) {
+      int accepted = accept4(listen_fd_, nullptr, nullptr, SOCK_CLOEXEC);
+      if (accepted >= 0) {
+        ucred credentials = {};
+        socklen_t length = sizeof(credentials);
+        if (getsockopt(accepted, SOL_SOCKET, SO_PEERCRED, &credentials, &length) < 0 ||
+            credentials.uid != 0 || client_fd >= 0) {
+          ALOGW("hdmi-los: rejected composer client uid=%u", credentials.uid);
+          close(accepted);
+        } else {
+          client_fd = accepted;
+          ALOGI("hdmi-los: root broker connected");
+        }
+      }
+    }
+
+    if (client_fd >= 0 && result > 0 && (fds[2].revents & POLLIN)) {
+      hdmi_los_message request = {};
+      ssize_t received;
+      do {
+        received = recv(client_fd, &request, sizeof(request), 0);
+      } while (received < 0 && errno == EINTR);
+      if (received != static_cast<ssize_t>(sizeof(request)) ||
+          !HandleRequest(client_fd, request)) {
+        shutdown(client_fd, SHUT_RDWR);
+        close(client_fd);
+        client_fd = -1;
+        controller_->ReleaseHdmiLease("broker disconnected");
+        deadline_ms_ = 0;
+      }
+    }
+    if (client_fd >= 0 && result > 0 &&
+        (fds[2].revents & (POLLERR | POLLHUP | POLLNVAL))) {
+      shutdown(client_fd, SHUT_RDWR);
+      close(client_fd);
+      client_fd = -1;
+      controller_->ReleaseHdmiLease("broker disconnected");
+      deadline_ms_ = 0;
+    }
+  }
+
+  if (client_fd >= 0) close(client_fd);
+  controller_->ReleaseHdmiLease("composer lease server stopped");
+}
+
+}  // namespace sdm
