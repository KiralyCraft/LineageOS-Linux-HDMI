+// Information for a deliberately short-lived DRM lease of a pluggable display.
+// The descriptor is owned by the caller and must be closed after SCM_RIGHTS
+// delivery. Only the DRM-owning display implementation may populate it.
+struct DisplayLeaseInfo {
+  int lease_fd = -1;
+  uint32_t connector_id = 0;
+  uint32_t crtc_id = 0;
+  uint32_t plane_id = 0;
+  uint32_t lessee_id = 0;
+};
