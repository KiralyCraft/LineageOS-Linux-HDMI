+DisplayError HWDeviceDRM::PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
+  if (!lease || disp_type_ != DRMDisplayType::TV || lease_prepared_ || lease_active_ ||
+      dev_fd_ < 0 || !drmIsMaster(dev_fd_) || !active_) {
+    return kErrorNotSupported;
+  }
+
+  drmModePlaneResPtr resources = drmModeGetPlaneResources(dev_fd_);
+  if (!resources) {
+    DLOGE("hdmi-los: cannot enumerate DRM planes: %s", strerror(errno));
+    return kErrorHardware;
+  }
+
+  uint32_t selected = 0;
+  for (uint32_t i = 0; i < resources->count_planes; ++i) {
+    drmModePlanePtr plane = drmModeGetPlane(dev_fd_, resources->planes[i]);
+    uint64_t type = UINT64_MAX;
+    if (plane && plane->crtc_id == token_.crtc_id &&
+        GetDrmProperty(dev_fd_, plane->plane_id, DRM_MODE_OBJECT_PLANE, "type", nullptr, &type) &&
+        type == DRM_PLANE_TYPE_PRIMARY) {
+      selected = plane->plane_id;
+    }
+    if (plane) drmModeFreePlane(plane);
+    if (selected) break;
+  }
+  drmModeFreePlaneResources(resources);
+  if (!selected) {
+    DLOGE("hdmi-los: external CRTC %u has no active primary plane", token_.crtc_id);
+    return kErrorResources;
+  }
+
+  lease_plane_id_ = selected;
+  lease_prepared_ = true;
+  lease->connector_id = token_.conn_id;
+  lease->crtc_id = token_.crtc_id;
+  lease->plane_id = selected;
+  DLOGI("hdmi-los: prepared connector=%u crtc=%u primary-plane=%u",
+        token_.conn_id, token_.crtc_id, selected);
+  return kErrorNone;
+}
+
+DisplayError HWDeviceDRM::CreateExternalDisplayLease(DisplayLeaseInfo *lease) {
+  if (!lease || !lease_prepared_ || lease_active_ || lease_plane_id_ == 0 || active_) {
+    return kErrorParameters;
+  }
+
+  bool connected = false;
+  if (IsExternalDisplayLeaseConnected(&connected) != kErrorNone || !connected) {
+    return kErrorDeviceRemoved;
+  }
+
+  drmModePlanePtr plane = drmModeGetPlane(dev_fd_, lease_plane_id_);
+  if (!plane || (plane->crtc_id != 0 && plane->crtc_id != token_.crtc_id)) {
+    if (plane) drmModeFreePlane(plane);
+    DLOGE("hdmi-los: prepared plane was reassigned before lease creation");
+    return kErrorResources;
+  }
+  drmModeFreePlane(plane);
+
+  uint32_t objects[] = {token_.conn_id, token_.crtc_id, lease_plane_id_};
+  uint32_t lessee_id = 0;
+  int fd = drmModeCreateLease(dev_fd_, objects, 3, O_CLOEXEC, &lessee_id);
+  if (fd < 0) {
+    DLOGE("hdmi-los: drmModeCreateLease failed: %s", strerror(errno));
+    return kErrorHardware;
+  }
+
+  lease_active_ = true;
+  lease_lessee_id_ = lessee_id;
+  lease->lease_fd = fd;
+  lease->connector_id = token_.conn_id;
+  lease->crtc_id = token_.crtc_id;
+  lease->plane_id = lease_plane_id_;
+  lease->lessee_id = lessee_id;
+  DLOGI("hdmi-los: created DRM lease %u", lessee_id);
+  return kErrorNone;
+}
+
+DisplayError HWDeviceDRM::RevokeExternalDisplayLease() {
+  if (!lease_active_) {
+    return kErrorNone;
+  }
+  if (drmModeRevokeLease(dev_fd_, lease_lessee_id_) < 0 && errno != ENOENT) {
+    DLOGE("hdmi-los: drmModeRevokeLease(%u) failed: %s", lease_lessee_id_, strerror(errno));
+    return kErrorHardware;
+  }
+  lease_active_ = false;
+  DLOGI("hdmi-los: revoked DRM lease %u", lease_lessee_id_);
+  return kErrorNone;
+}
+
+DisplayError HWDeviceDRM::ResetExternalDisplayLease() {
+  DisplayError result = kErrorNone;
+  if (lease_active_ && RevokeExternalDisplayLease() != kErrorNone) {
+    result = kErrorHardware;
+  }
+
+  if (lease_plane_id_ != 0) {
+    uint32_t crtc_property = 0;
+    uint32_t fb_property = 0;
+    if (GetDrmProperty(dev_fd_, lease_plane_id_, DRM_MODE_OBJECT_PLANE, "CRTC_ID",
+                       &crtc_property, nullptr) &&
+        GetDrmProperty(dev_fd_, lease_plane_id_, DRM_MODE_OBJECT_PLANE, "FB_ID",
+                       &fb_property, nullptr)) {
+      drmModeAtomicReqPtr request = drmModeAtomicAlloc();
+      if (!request || drmModeAtomicAddProperty(request, lease_plane_id_, crtc_property, 0) < 0 ||
+          drmModeAtomicAddProperty(request, lease_plane_id_, fb_property, 0) < 0 ||
+          drmModeAtomicCommit(dev_fd_, request,
+                              DRM_MODE_ATOMIC_ALLOW_MODESET | DRM_MODE_ATOMIC_TEST_ONLY,
+                              nullptr) < 0 ||
+          drmModeAtomicCommit(dev_fd_, request, DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr) < 0) {
+        DLOGE("hdmi-los: failed to detach leased plane %u: %s", lease_plane_id_,
+              strerror(errno));
+        result = kErrorHardware;
+      }
+      if (request) drmModeAtomicFree(request);
+    } else {
+      result = kErrorHardware;
+    }
+  }
+
+  bool connected = false;
+  IsExternalDisplayLeaseConnected(&connected);
+  if (connected && drm_atomic_intf_) {
+    drm_atomic_intf_->Perform(DRMOps::PLANES_RESET_CACHE, token_.crtc_id);
+    drm_atomic_intf_->Perform(DRMOps::CRTC_RESET_CACHE, token_.crtc_id);
+    drmModeModeInfo current_mode = connector_info_.modes[current_mode_index_].mode;
+    drm_atomic_intf_->Perform(DRMOps::CONNECTOR_SET_CRTC, token_.conn_id, token_.crtc_id);
+    drm_atomic_intf_->Perform(DRMOps::CRTC_SET_MODE, token_.crtc_id, &current_mode);
+    drm_atomic_intf_->Perform(DRMOps::CRTC_SET_ACTIVE, token_.crtc_id, 0);
+    drm_atomic_intf_->Perform(DRMOps::CONNECTOR_SET_POWER_MODE, token_.conn_id,
+                              DRMPowerMode::OFF);
+    if (NullCommit(true /* synchronous */, false /* retain_planes */) != 0) {
+      DLOGE("hdmi-los: synchronized external-display reset failed");
+      result = kErrorHardware;
+    }
+  }
+
+  lease_prepared_ = false;
+  lease_active_ = false;
+  lease_plane_id_ = 0;
+  lease_lessee_id_ = 0;
+  return result;
+}
+
+DisplayError HWDeviceDRM::IsExternalDisplayLeaseConnected(bool *connected) {
+  if (!connected || dev_fd_ < 0 || token_.conn_id == 0) {
+    return kErrorParameters;
+  }
+  drmModeConnectorPtr connector = drmModeGetConnector(dev_fd_, token_.conn_id);
+  if (!connector) {
+    *connected = false;
+    return kErrorDeviceRemoved;
+  }
+  *connected = connector->connection == DRM_MODE_CONNECTED;
+  drmModeFreeConnector(connector);
+  return kErrorNone;
+}
