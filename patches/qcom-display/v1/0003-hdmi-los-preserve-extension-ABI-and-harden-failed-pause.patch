From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KiralyCraft <alexucu@gmail.com>
Date: Mon, 31 Aug 2026 20:06:12 +0300
Subject: [PATCH] hdmi-los: preserve extension ABI and harden failed pause

---
 composer/hwc_display.cpp             |  4 ++++
 composer/hwc_display.h               |  1 +
 composer/hwc_session.cpp             |  3 ++-
 sdm/include/core/display_interface.h | 13 ++++++++-----
 sdm/include/private/hw_interface.h   |  9 ++++++---
 sdm/libs/core/display_base.cpp       |  5 +++++
 sdm/libs/core/display_base.h         |  1 +
 sdm/libs/dal/hw_device_drm.cpp       | 11 ++++++++++-
 sdm/libs/dal/hw_device_drm.h         |  1 +
 9 files changed, 39 insertions(+), 10 deletions(-)

diff --git a/composer/hwc_display.cpp b/composer/hwc_display.cpp
index ad32f46..7e8706a 100755
--- a/composer/hwc_display.cpp
+++ b/composer/hwc_display.cpp
@@ -2270,6 +2270,10 @@ int HWCDisplay::RevokeExternalDisplayLease() {
   return (error == kErrorNone || error == kErrorNotSupported) ? 0 : -EIO;
 }
 
+int HWCDisplay::AbortExternalDisplayLeasePreparation() {
+  return display_intf_->AbortExternalDisplayLeasePreparation() == kErrorNone ? 0 : -EIO;
+}
+
 int HWCDisplay::ResetExternalDisplayLease() {
   return display_intf_->ResetExternalDisplayLease() == kErrorNone ? 0 : -EIO;
 }
diff --git a/composer/hwc_display.h b/composer/hwc_display.h
index 3ad5b4e..182237a 100644
--- a/composer/hwc_display.h
+++ b/composer/hwc_display.h
@@ -487,6 +487,7 @@ class HWCDisplay : public DisplayEventHandler {
   int PrepareExternalDisplayLease(DisplayLeaseInfo *lease);
   int CreateExternalDisplayLease(DisplayLeaseInfo *lease);
   int RevokeExternalDisplayLease();
+  int AbortExternalDisplayLeasePreparation();
   int ResetExternalDisplayLease();
   bool IsExternalDisplayLeaseConnected();
   bool IsExternalDisplayLeaseReady() const;
diff --git a/composer/hwc_session.cpp b/composer/hwc_session.cpp
index db87b1b..5e2aa96 100644
--- a/composer/hwc_session.cpp
+++ b/composer/hwc_session.cpp
@@ -447,7 +447,8 @@ int HWCSession::AcquireHdmiLease(hdmi_los_message *status, int *lease_fd) {
       } else if (display->PrepareExternalDisplayLease(&lease) != 0) {
         hdmi_lease_detail_ = "cannot pin the external display primary plane";
       } else if (display->SetDisplayStatus(HWCDisplay::kDisplayStatusPause) != 0) {
-        display->ResetExternalDisplayLease();
+        display->AbortExternalDisplayLeasePreparation();
+        display->SetDisplayStatus(HWCDisplay::kDisplayStatusResume);
         hdmi_lease_detail_ = "Android could not pause the external display";
       } else if (display->CreateExternalDisplayLease(&lease) != 0 || lease.lease_fd < 0) {
         display->RevokeExternalDisplayLease();
diff --git a/sdm/include/core/display_interface.h b/sdm/include/core/display_interface.h
index 3fc83bf..6f7ba39 100644
--- a/sdm/include/core/display_interface.h
+++ b/sdm/include/core/display_interface.h
@@ -1351,8 +1351,13 @@ class DisplayInterface {
   */
   virtual DisplayError SetDemuraState(int state) = 0;
 
-  // Experimental pdx234 external-display lease hooks. Implementations other
-  // than the DRM pluggable display deliberately reject these operations.
+ protected:
+  virtual ~DisplayInterface() { }
+
+ public:
+  // Keep these hooks after the pre-existing virtual destructor.  Qualcomm's
+  // proprietary extensions were compiled against the old vtable; appending
+  // slots preserves every existing slot number.
   virtual DisplayError PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
     return kErrorNotSupported;
   }
@@ -1360,13 +1365,11 @@ class DisplayInterface {
     return kErrorNotSupported;
   }
   virtual DisplayError RevokeExternalDisplayLease() { return kErrorNotSupported; }
+  virtual DisplayError AbortExternalDisplayLeasePreparation() { return kErrorNotSupported; }
   virtual DisplayError ResetExternalDisplayLease() { return kErrorNotSupported; }
   virtual DisplayError IsExternalDisplayLeaseConnected(bool *connected) {
     return kErrorNotSupported;
   }
-
- protected:
-  virtual ~DisplayInterface() { }
 };
 
 }  // namespace sdm
diff --git a/sdm/include/private/hw_interface.h b/sdm/include/private/hw_interface.h
index 825e794..c1886bc 100644
--- a/sdm/include/private/hw_interface.h
+++ b/sdm/include/private/hw_interface.h
@@ -186,6 +186,11 @@ class HWInterface {
   virtual DisplayError CancelDeferredPowerMode() = 0;
   virtual void HandleCwbTeardown() = 0;
 
+ protected:
+  virtual ~HWInterface() { }
+
+ public:
+  // ABI rule: new virtuals are appended after the old destructor slots.
   virtual DisplayError PrepareExternalDisplayLease(DisplayLeaseInfo *lease) {
     return kErrorNotSupported;
   }
@@ -193,13 +198,11 @@ class HWInterface {
     return kErrorNotSupported;
   }
   virtual DisplayError RevokeExternalDisplayLease() { return kErrorNotSupported; }
+  virtual DisplayError AbortExternalDisplayLeasePreparation() { return kErrorNotSupported; }
   virtual DisplayError ResetExternalDisplayLease() { return kErrorNotSupported; }
   virtual DisplayError IsExternalDisplayLeaseConnected(bool *connected) {
     return kErrorNotSupported;
   }
-
- protected:
-  virtual ~HWInterface() { }
 };
 
 }  // namespace sdm
diff --git a/sdm/libs/core/display_base.cpp b/sdm/libs/core/display_base.cpp
index a9a668a..7191f0a 100644
--- a/sdm/libs/core/display_base.cpp
+++ b/sdm/libs/core/display_base.cpp
@@ -1975,6 +1975,11 @@ DisplayError DisplayBase::RevokeExternalDisplayLease() {
   return hw_intf_->RevokeExternalDisplayLease();
 }
 
+DisplayError DisplayBase::AbortExternalDisplayLeasePreparation() {
+  ClientLock lock(disp_mutex_);
+  return hw_intf_->AbortExternalDisplayLeasePreparation();
+}
+
 DisplayError DisplayBase::ResetExternalDisplayLease() {
   ClientLock lock(disp_mutex_);
   return hw_intf_->ResetExternalDisplayLease();
diff --git a/sdm/libs/core/display_base.h b/sdm/libs/core/display_base.h
index 45b31d2..8c4f0c0 100644
--- a/sdm/libs/core/display_base.h
+++ b/sdm/libs/core/display_base.h
@@ -256,6 +256,7 @@ class DisplayBase : public DisplayInterface, public CompManagerEventHandler {
   DisplayError PrepareExternalDisplayLease(DisplayLeaseInfo *lease) override;
   DisplayError CreateExternalDisplayLease(DisplayLeaseInfo *lease) override;
   DisplayError RevokeExternalDisplayLease() override;
+  DisplayError AbortExternalDisplayLeasePreparation() override;
   DisplayError ResetExternalDisplayLease() override;
   DisplayError IsExternalDisplayLeaseConnected(bool *connected) override;
 
diff --git a/sdm/libs/dal/hw_device_drm.cpp b/sdm/libs/dal/hw_device_drm.cpp
index f31a675..95806dd 100644
--- a/sdm/libs/dal/hw_device_drm.cpp
+++ b/sdm/libs/dal/hw_device_drm.cpp
@@ -2647,13 +2647,23 @@ DisplayError HWDeviceDRM::RevokeExternalDisplayLease() {
   return kErrorNone;
 }
 
+DisplayError HWDeviceDRM::AbortExternalDisplayLeasePreparation() {
+  if (lease_active_ || lease_lessee_id_ != 0) {
+    return kErrorPermission;
+  }
+  lease_prepared_ = false;
+  lease_plane_id_ = 0;
+  lease_lessee_id_ = 0;
+  return kErrorNone;
+}
+
 DisplayError HWDeviceDRM::ResetExternalDisplayLease() {
   DisplayError result = kErrorNone;
   if (lease_active_ && RevokeExternalDisplayLease() != kErrorNone) {
     result = kErrorHardware;
   }
 
-  if (lease_plane_id_ != 0) {
+  if (lease_lessee_id_ != 0 && lease_plane_id_ != 0) {
     uint32_t crtc_property = 0;
     uint32_t fb_property = 0;
     if (GetDrmProperty(dev_fd_, lease_plane_id_, DRM_MODE_OBJECT_PLANE, "CRTC_ID",
diff --git a/sdm/libs/dal/hw_device_drm.h b/sdm/libs/dal/hw_device_drm.h
index da96f1d..653b0e4 100644
--- a/sdm/libs/dal/hw_device_drm.h
+++ b/sdm/libs/dal/hw_device_drm.h
@@ -182,5 +182,6 @@ class HWDeviceDRM : public HWInterface {
   DisplayError PrepareExternalDisplayLease(DisplayLeaseInfo *lease) override;
   DisplayError CreateExternalDisplayLease(DisplayLeaseInfo *lease) override;
   DisplayError RevokeExternalDisplayLease() override;
+  DisplayError AbortExternalDisplayLeasePreparation() override;
   DisplayError ResetExternalDisplayLease() override;
   DisplayError IsExternalDisplayLeaseConnected(bool *connected) override;
