+/* IdleNotify is normally paired with implicit DMA-BUF synchronization. KGSL
+ * needs an explicit consumer dependency: retain a separate record because the
+ * Present completion/vblank can be destroyed before GPU read completion. */
+struct present_copy_release {
+    struct xorg_list link;
+    PixmapPtr pixmap;
+    WindowPtr window;
+    CARD32 serial;
+    struct present_fence *idle_fence;
+    int fd;
+    OsTimerPtr timer;
+};
+
+static void
+present_copy_release_destroy(struct present_copy_release *release, Bool notify)
+{
+    RemoveNotifyFd(release->fd);
+    close(release->fd);
+    if (release->timer)
+        TimerFree(release->timer);
+    xorg_list_del(&release->link);
+    if (notify)
+        present_pixmap_idle(release->pixmap, release->window, release->serial,
+                            release->idle_fence);
+    present_fence_destroy(release->idle_fence);
+    dixDestroyPixmap(release->pixmap, release->pixmap->drawable.id);
+    free(release);
+}
+
+static void
+present_copy_release_ready(int fd, int ready, void *data)
+{
+    struct present_copy_release *release = data;
+    struct sync_file_info info = {0};
+    if (fd != release->fd || (ready & X_NOTIFY_ERROR) ||
+        ioctl(fd, SYNC_IOC_FILE_INFO, &info) < 0 || info.status <= 0)
+        FatalError("HDMI Present consumer fence failed; buffer not released\n");
+    present_copy_release_destroy(release, TRUE);
+}
+
+static CARD32
+present_copy_release_timeout(OsTimerPtr timer, CARD32 now, void *data)
+{
+    FatalError("HDMI Present consumer fence timed out; buffer not released\n");
+    return 0;
+}
+
+Bool
+present_set_copy_release(ScreenPtr screen, int (*export_fence)(ScreenPtr),
+                         void (*finish)(ScreenPtr))
+{
+    present_screen_priv_ptr priv = present_screen_priv(screen);
+    if (!priv || !finish || !xorg_list_is_empty(&priv->copy_releases))
+        return FALSE;
+    priv->copy_export_fence = export_fence;
+    priv->copy_finish = finish;
+    return TRUE;
+}
+
+void
+present_copy_release_forget_window(WindowPtr window)
+{
+    present_screen_priv_ptr priv = present_screen_priv(window->drawable.pScreen);
+    struct present_copy_release *release;
+    xorg_list_for_each_entry(release, &priv->copy_releases, link) {
+        if (release->window == window)
+            release->window = NULL;
+    }
+}
+
+void
+present_drain_copy_releases(ScreenPtr screen)
+{
+    present_screen_priv_ptr priv = present_screen_priv(screen);
+    struct present_copy_release *release, *tmp;
+    if (!priv || xorg_list_is_empty(&priv->copy_releases))
+        return;
+    /* Teardown only. Unregistering readiness does not cancel GPU work. */
+    priv->copy_finish(screen);
+    xorg_list_for_each_entry_safe(release, tmp, &priv->copy_releases, link) {
+        struct sync_file_info info = {0};
+        if (ioctl(release->fd, SYNC_IOC_FILE_INFO, &info) < 0 || info.status <= 0)
+            FatalError("HDMI Present consumer teardown fence failed\n");
+        present_copy_release_destroy(release, TRUE);
+    }
+}
+
+static void
+present_copy_idle(present_vblank_ptr vblank)
+{
+    ScreenPtr screen = vblank->window->drawable.pScreen;
+    present_screen_priv_ptr priv = present_screen_priv(screen);
+    struct present_copy_release *release;
+    struct pollfd pollfd;
+    int ret;
+    if (!priv->copy_finish) {
+        present_pixmap_idle(vblank->pixmap, vblank->window, vblank->serial,
+                            vblank->idle_fence);
+        return;
+    }
+    if (!priv->copy_export_fence) {
+        /* Explicit diagnostic control, never a silent fallback. */
+        priv->copy_finish(screen);
+        present_pixmap_idle(vblank->pixmap, vblank->window, vblank->serial,
+                            vblank->idle_fence);
+        return;
+    }
+    release = calloc(1, sizeof(*release));
+    if (!release)
+        FatalError("HDMI Present consumer release allocation failed\n");
+    release->fd = priv->copy_export_fence(screen);
+    if (release->fd < 0)
+        FatalError("HDMI Present consumer fence export failed\n");
+    release->pixmap = vblank->pixmap;
+    release->pixmap->refcnt++;
+    release->window = vblank->window;
+    release->serial = vblank->serial;
+    release->idle_fence = vblank->idle_fence;
+    vblank->idle_fence = NULL; /* record owns the Sync wrapper until release */
+    xorg_list_append(&release->link, &priv->copy_releases);
+    if (!SetNotifyFd(release->fd, present_copy_release_ready, X_NOTIFY_READ, release))
+        FatalError("HDMI Present consumer fence registration failed\n");
+    release->timer = TimerSet(NULL, 0, 5000, present_copy_release_timeout, release);
+    if (!release->timer)
+        FatalError("HDMI Present consumer timeout allocation failed\n");
+    pollfd = (struct pollfd){.fd = release->fd, .events = POLLIN};
+    do { ret = poll(&pollfd, 1, 0); } while (ret < 0 && errno == EINTR);
+    if (ret < 0 || (ret && !(pollfd.revents & POLLIN)))
+        FatalError("HDMI Present consumer fence poll failed\n");
+    if (ret)
+        present_copy_release_ready(release->fd, X_NOTIFY_READ, release);
+}
