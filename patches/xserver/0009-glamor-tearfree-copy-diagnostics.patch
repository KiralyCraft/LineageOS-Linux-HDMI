From: HDMI diagnostics
Subject: [PATCH] glamor: opt-in TearFree ordering and RGB copy diagnostics

No default behavior change. Explicit diagnostics add GPU waits or sampled
readback and must not be used for performance claims. E remains unvalidated.

--- a/glamor/glamor_copy.c
+++ b/glamor/glamor_copy.c
@@ -337,6 +337,83 @@
 #define GL_TILE_RASTER_ORDER_INCREASING_Y_MESA   0x8BBA
 #endif
 
+/* Explicit correctness diagnostic, never enabled by the normal launcher.
+ * Readback serializes GPU work and can conceal a timing bug. A match proves
+ * only that these damaged RGB pixels agree after that synchronization; it
+ * cannot validate scanout cadence or that the root itself is correct.
+ */
+static void
+glamor_tearfree_verify(GLint src, GLint dst, BoxPtr boxes, int nbox,
+                       unsigned long long serial)
+{
+    GLint read_fbo, pack_buffer, alignment, row_length, skip_rows, skip_pixels;
+    unsigned char *a, *b;
+    unsigned long long checked = 0, mismatched = 0;
+    int max_width = 0, first_x = -1, first_y = -1;
+
+    for (int i = 0; i < nbox; ++i)
+        if (boxes[i].x2 - boxes[i].x1 > max_width)
+            max_width = boxes[i].x2 - boxes[i].x1;
+    if (max_width <= 0)
+        return;
+    /* At 4K, the two strips occupy less than 1 MiB together. */
+    a = malloc((size_t)max_width * 32 * 4);
+    b = malloc((size_t)max_width * 32 * 4);
+    if (!a || !b) {
+        free(a);
+        free(b);
+        LogMessage(X_WARNING, "HDMI_E_VERIFY serial=%llu skipped=allocation\n", serial);
+        return;
+    }
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skip_rows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skip_pixels);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    for (int i = 0; i < nbox; ++i) {
+        int width = boxes[i].x2 - boxes[i].x1;
+        for (int y = boxes[i].y1; y < boxes[i].y2; y += 32) {
+            int height = boxes[i].y2 - y;
+            if (height > 32) height = 32;
+            /* Poison both outputs differently so a failed read cannot
+             * produce a false match from uninitialized/reused memory. */
+            memset(a, 0x35, (size_t)width * height * 4);
+            memset(b, 0xca, (size_t)width * height * 4);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, src);
+            glReadPixels(boxes[i].x1, y, width, height, GL_RGBA, GL_UNSIGNED_BYTE, a);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, dst);
+            glReadPixels(boxes[i].x1, y, width, height, GL_RGBA, GL_UNSIGNED_BYTE, b);
+            for (int p = 0; p < width * height; ++p) {
+                ++checked;
+                if (memcmp(a + p * 4, b + p * 4, 3)) {
+                    if (!mismatched) {
+                        first_x = boxes[i].x1 + p % width;
+                        first_y = y + p / width;
+                    }
+                    ++mismatched;
+                }
+            }
+        }
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+    free(a);
+    free(b);
+    LogMessage(mismatched ? X_WARNING : X_INFO,
+               "HDMI_E_VERIFY serial=%llu rgb_pixels=%llu mismatched=%llu first=%d,%d readback_synchronizes=1\n",
+               serial, checked, mismatched, first_x, first_y);
+}
+
 /* Candidate E is deliberately limited to the root-to-TearFree transfer.
  * Generic window copies (including overlap-safe scratch copies) use the
  * established shader path. API selection does not itself prove CP_BLIT. */
@@ -349,7 +426,7 @@
     glamor_pixmap_private *dpriv = glamor_get_pixmap_private(dp);
     BoxPtr boxes = RegionRects(damage);
     int nbox = RegionNumRects(damage);
-    static int enabled = -1;
+    static int enabled = -1, diagnostic;
     static unsigned long long blits, pixels, failures;
     GLint read_fbo, draw_fbo;
     GLboolean scissor;
@@ -362,6 +439,16 @@
         enabled = setting && !strcmp(setting, "blit");
         if (enabled)
             LogMessage(X_INFO, "HDMI_LOS_XORG_COPY_ABI=2 root-to-TearFree blits enabled\n");
+        setting = getenv("HDMI_LOS_E_DIAGNOSTIC");
+        if (setting && enabled) {
+            if (!strcmp(setting, "finish-before")) diagnostic = 1;
+            else if (!strcmp(setting, "finish-after")) diagnostic = 2;
+            else if (!strcmp(setting, "verify")) diagnostic = 3;
+            if (diagnostic)
+                LogMessage(X_INFO, "HDMI_LOS_E_DIAGNOSTIC_ABI=1 mode=%s correctness-only; synchronous diagnostic\n", setting);
+            else
+                LogMessage(X_WARNING, "HDMI E diagnostic ignored: unknown mode\n");
+        }
     }
     if (!enabled || !priv->has_fbo_blit || nbox < 1 || nbox > 32 ||
         sp != screen->GetScreenPixmap(screen) || sp == dp ||
@@ -407,12 +494,20 @@
     if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE ||
         glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
         goto restore;
+    if (diagnostic == 1)
+        glFinish();
     for (int i = 0; i < nbox; i++) {
         BoxPtr b = &boxes[i];
         glBlitFramebuffer(b->x1, b->y1, b->x2, b->y2,
                           b->x1, b->y1, b->x2, b->y2,
                           GL_COLOR_BUFFER_BIT, GL_NEAREST);
     }
+    if (diagnostic == 2)
+        glFinish();
+    /* Check the first eligible copy, then every 30th. Do not save pixels or
+     * images to disk, and do not replace a mismatch with a shader copy. */
+    if (diagnostic == 3 && !(blits % 30))
+        glamor_tearfree_verify(spriv->fbo->fb, dpriv->fbo->fb, boxes, nbox, blits + 1);
     ok = TRUE;
 restore:
     glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
