 }
@@ -642,6 +647,17 @@ ms_tearfree_dri_notify(drmmode_tearfree_ptr trf, uint64_t msc, uint64_t usec)
     }
 }
 
+static void ms_tearfree_copy_clear(xf86CrtcPtr crtc, Bool restore);
+static void
+ms_tearfree_kernel_event(xf86CrtcPtr crtc)
+{
+    drmmode_crtc_private_ptr dc=crtc->driver_private;
+    drmmode_tearfree_ptr trf=&dc->tearfree;
+    if (trf->kernel_seq && trf->copy_pending)
+        ms_tearfree_copy_clear(crtc,FALSE);
+    trf->kernel_seq=0;
+}
+
 static void
 ms_tearfree_flip_abort(void *data)
 {
@@ -649,6 +665,7 @@ ms_tearfree_flip_abort(void *data)
     drmmode_crtc_private_ptr drmmode_crtc = crtc->driver_private;
     drmmode_tearfree_ptr trf = &drmmode_crtc->tearfree;
 
+    ms_tearfree_kernel_event(crtc);
     trf->flip_seq = 0;
     ms_tearfree_dri_abort_all(crtc);
 }
@@ -660,6 +677,7 @@ ms_tearfree_flip_handler(uint64_t msc, uint64_t usec, void *data)
     drmmode_crtc_private_ptr drmmode_crtc = crtc->driver_private;
     drmmode_tearfree_ptr trf = &drmmode_crtc->tearfree;
 
+    ms_tearfree_kernel_event(crtc);
     /* Swap the buffers and complete the flip */
     trf->back_idx ^= 1;
     trf->flip_seq = 0;
@@ -687,6 +705,76 @@ ms_tearfree_copy_clear(xf86CrtcPtr crtc, Bool restore)
     trf->copy_pending = FALSE;
 }
 
+static Bool
+ms_kernel_present_status(xf86CrtcPtr crtc, Bool cancel, struct hdmi_present_status *status)
+{
+    drmmode_crtc_private_ptr dc=crtc->driver_private;
+    *status=(struct hdmi_present_status){.size=sizeof(*status),.abi_version=HDMI_COMPANION_ABI_VERSION};
+    return ioctl(dc->tearfree.kernel_fd,cancel ? HDMI_COMPANION_CANCEL_PRESENT : HDMI_COMPANION_PRESENT_STATUS,status)==0;
+}
+
+static void
+ms_kernel_present_ready(int fd, int ready, void *data)
+{
+    xf86CrtcPtr crtc=data;
+    drmmode_crtc_private_ptr dc=crtc->driver_private;
+    drmmode_tearfree_ptr trf=&dc->tearfree;
+    struct hdmi_present_status status;
+    if (!ms_kernel_present_status(crtc,FALSE,&status) || (ready & X_NOTIFY_ERROR))
+        FatalError("HDMI kernel presenter status failed\n");
+    if (!trf->kernel_seq) return;
+    if (status.generation != trf->kernel_generation || status.serial != trf->kernel_seq)
+        FatalError("HDMI kernel presenter generation/serial mismatch\n");
+    if (status.state == HDMI_PRESENT_SUBMITTED || status.state == HDMI_PRESENT_COMPLETE) {
+        /* This transition happens only after the driver accepted a real flip.
+         * Actual completion still arrives exclusively through the DRM queue. */
+        trf->flip_seq=trf->kernel_seq;
+        if (trf->copy_pending) ms_tearfree_copy_clear(crtc,FALSE);
+    } else if (status.state == HDMI_PRESENT_FAILED || status.state == HDMI_PRESENT_CANCELLED) {
+        uint32_t seq=trf->kernel_seq; trf->kernel_seq=0;
+        ms_drm_abort_seq(crtc->scrn,seq);
+        if (trf->copy_pending) ms_tearfree_copy_clear(crtc,TRUE);
+        FatalError("HDMI kernel presenter rejected deferred flip: %d\n",status.error);
+    }
+}
+
+static Bool
+ms_kernel_present_start(xf86CrtcPtr crtc)
+{
+    drmmode_crtc_private_ptr dc=crtc->driver_private;
+    drmmode_tearfree_ptr trf=&dc->tearfree;
+    xf86CrtcConfigPtr config=XF86_CRTC_CONFIG_PTR(crtc->scrn);
+    struct hdmi_companion_create bind={.size=sizeof(bind),.abi_version=HDMI_COMPANION_ABI_VERSION,
+        .lease_fd=dc->drmmode->fd,.session_fd=-1,.crtc_id=dc->mode_crtc->crtc_id,.plane_id=dc->plane_id};
+    struct hdmi_present_request request;
+    if (trf->kernel_fd < 0) {
+        int control=open("/dev/hdmi_companion",O_RDWR|O_CLOEXEC);
+        if (control < 0) return FALSE;
+        for (int i=0;i<config->num_output;i++) if (config->output[i]->crtc==crtc) {
+            drmmode_output_private_ptr output=config->output[i]->driver_private;
+            if (bind.connector_id) { close(control); return FALSE; }
+            bind.connector_id=output->mode_output->connector_id;
+        }
+        if (!bind.connector_id || !bind.plane_id || ioctl(control,HDMI_COMPANION_CREATE_PRESENTER,&bind)<0) {
+            close(control); return FALSE;
+        }
+        close(control); trf->kernel_fd=bind.session_fd; trf->kernel_generation=bind.generation;
+        if (!SetNotifyFd(trf->kernel_fd,ms_kernel_present_ready,X_NOTIFY_READ,crtc)) return FALSE;
+        xf86DrvMsg(crtc->scrn->scrnIndex,X_INFO,"HDMI_LOS_XORG_PRESENTER_ABI=1 kernel deferred presenter generation=%llu\n",(unsigned long long)bind.generation);
+    }
+    /* The reserved queue entry has no submitted-flip state yet. Every drain
+     * first cancels copy-pending work, resolving whether a DRM event exists. */
+    trf->kernel_seq=ms_drm_queue_alloc(crtc,crtc,ms_tearfree_flip_handler,ms_tearfree_flip_abort);
+    if (!trf->kernel_seq) return FALSE;
+    request=(struct hdmi_present_request){.size=sizeof(request),.abi_version=HDMI_COMPANION_ABI_VERSION,
+        .framebuffer_id=trf->buf[trf->copy_idx].fb_id,.acquire_fd=trf->copy_fd,
+        .generation=trf->kernel_generation,.serial=trf->kernel_seq};
+    if (ioctl(trf->kernel_fd,HDMI_COMPANION_PRESENT,&request)<0) {
+        uint32_t seq=trf->kernel_seq; trf->kernel_seq=0; ms_drm_abort_seq(crtc->scrn,seq); return FALSE;
+    }
+    return TRUE;
+}
+
 void
 ms_tearfree_cancel_copy(xf86CrtcPtr crtc)
 {
@@ -697,6 +785,19 @@ ms_tearfree_cancel_copy(xf86CrtcPtr crtc)
     /* Disable/modeset/teardown may destroy the destination. Drain only here;
      * closing a native fence does not cancel the submitted GPU work. */
     modesettingPTR(crtc->scrn)->glamor.finish(xf86ScrnToScreen(crtc->scrn));
+    if (trf->kernel_seq) {
+        struct hdmi_present_status status;
+        uint32_t seq=trf->kernel_seq;
+        if (!ms_kernel_present_status(crtc,TRUE,&status))
+            FatalError("HDMI kernel presenter cancellation failed\n");
+        if (status.state == HDMI_PRESENT_SUBMITTED || status.state == HDMI_PRESENT_COMPLETE) {
+            trf->flip_seq=seq;
+            ms_tearfree_copy_clear(crtc,FALSE);
+            return;
+        }
+        trf->kernel_seq=0;
+        ms_drm_abort_seq(crtc->scrn,seq);
+    }
     ms_tearfree_copy_clear(crtc, TRUE);
 }
 
@@ -792,8 +893,13 @@ ms_tearfree_start_copy(ScreenPtr screen, xf86CrtcPtr crtc)
     boxes = RegionRects(&trf->copy_damage);
     for (i = 0; i < RegionNumRects(&trf->copy_damage); ++i)
         trf->pixels += (uint64_t)(boxes[i].x2 - boxes[i].x1) * (boxes[i].y2 - boxes[i].y1);
+    if (getenv("HDMI_LOS_PRESENTER") && !strcmp(getenv("HDMI_LOS_PRESENTER"),"kernel")) {
+        if (!ms_kernel_present_start(crtc))
+            FatalError("HDMI kernel presenter could not accept deferred flip\n");
+    } else {
     if (!SetNotifyFd(trf->copy_fd, ms_tearfree_copy_ready, X_NOTIFY_READ, crtc))
         FatalError("HDMI asynchronous TearFree could not register native-fence readiness\n");
+    }
     trf->copy_timer = TimerSet(trf->copy_timer, 0, 2000, ms_tearfree_copy_timeout, crtc);
     if (!trf->copy_timer)
         FatalError("HDMI asynchronous TearFree could not arm recovery timeout\n");
