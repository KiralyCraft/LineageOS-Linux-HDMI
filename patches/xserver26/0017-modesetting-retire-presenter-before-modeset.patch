+/* The broker retires the timing generation at the synchronous SETCRTC
+ * barrier. Retire our presenter first, including a real submitted DRM event;
+ * closing an fd or aborting a queue entry does not cancel GPU/scanout work. */
+static void
+drmmode_retire_kernel_presenter(xf86CrtcPtr crtc)
+{
+#ifdef HAVE_GBM
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    const char *presenter = getenv("HDMI_LOS_PRESENTER");
+    if (!presenter || strcmp(presenter, "kernel"))
+        return;
+    ms_tearfree_cancel_copy(crtc);
+    while (trf->flip_seq)
+        ms_drain_drm_events(xf86ScrnToScreen(crtc->scrn));
+    if (trf->kernel_fd >= 0) {
+        RemoveNotifyFd(trf->kernel_fd);
+        close(trf->kernel_fd);
+        trf->kernel_fd = -1;
+        trf->kernel_generation = 0;
+    }
+    /* Removal of an active FB can disable the CRTC, even before SETCRTC.
+     * Begin the broker-owned transaction before releasing any scanout BO. */
+    if (trf->buf[0].px || trf->buf[1].px) {
+        typedef int (*prepare_fn)(int, uint32_t);
+        prepare_fn prepare = (prepare_fn)dlsym(RTLD_DEFAULT, "hdmi_los_modeset_prepare");
+        if (!prepare || !prepare(dc->drmmode->fd, dc->mode_crtc->crtc_id))
+            FatalError("HDMI modeset could not retire timing before scanout release\n");
+    }
+    xf86DrvMsg(crtc->scrn->scrnIndex, X_INFO,
+               "HDMI_LOS_MODESET_TIMING_ABI=1 retired presenter before scanout release\n");
+#endif
+}
