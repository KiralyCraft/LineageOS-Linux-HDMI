+static void
+ms_tearfree_copy_clear(xf86CrtcPtr crtc, Bool restore)
+{
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    if (trf->copy_fd >= 0) {
+        RemoveNotifyFd(trf->copy_fd);
+        close(trf->copy_fd);
+    }
+    trf->copy_fd = -1;
+    if (trf->copy_timer)
+        TimerCancel(trf->copy_timer);
+    if (restore)
+        RegionUnion(&trf->buf[trf->copy_idx].dmg,
+                    &trf->buf[trf->copy_idx].dmg, &trf->copy_damage);
+    RegionUninit(&trf->copy_damage);
+    trf->copy_pending = FALSE;
+}
+
+void
+ms_tearfree_cancel_copy(xf86CrtcPtr crtc)
+{
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    if (!trf->copy_pending)
+        return;
+    /* Disable/modeset/teardown may destroy the destination. Drain only here;
+     * closing a native fence does not cancel the submitted GPU work. */
+    modesettingPTR(crtc->scrn)->glamor.finish(xf86ScrnToScreen(crtc->scrn));
+    ms_tearfree_copy_clear(crtc, TRUE);
+}
+
+void
+ms_tearfree_cancel_copies(ScreenPtr screen)
+{
+    xf86CrtcConfigPtr config = XF86_CRTC_CONFIG_PTR(xf86ScreenToScrn(screen));
+    int i;
+    for (i = 0; i < config->num_crtc; ++i)
+        ms_tearfree_cancel_copy(config->crtc[i]);
+}
+
+static CARD32
+ms_tearfree_copy_timeout(OsTimerPtr timer, CARD32 now, void *data)
+{
+    xf86CrtcPtr crtc = data;
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    if (dc->tearfree.copy_pending)
+        FatalError("HDMI asynchronous TearFree copy timed out; unfinished buffer was not displayed\n");
+    return 0;
+}
+
+static void
+ms_tearfree_copy_ready(int fd, int ready, void *data)
+{
+    xf86CrtcPtr crtc = data;
+    ScreenPtr screen = xf86ScrnToScreen(crtc->scrn);
+    modesettingPtr ms = modesettingPTR(crtc->scrn);
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    struct sync_file_info info = {0};
+    uint32_t idx, seq;
+    uint64_t elapsed;
+
+    if (!trf->copy_pending || trf->copy_fd != fd)
+        return;
+    if ((ready & X_NOTIFY_ERROR) || ioctl(fd, SYNC_IOC_FILE_INFO, &info) < 0 || info.status <= 0)
+        FatalError("HDMI asynchronous TearFree fence failed; unfinished buffer was not displayed\n");
+    elapsed = GetTimeInMicros() - trf->copy_exported_us;
+    trf->ready_us += elapsed;
+    if (elapsed > trf->max_ready_us) trf->max_ready_us = elapsed;
+    idx = trf->copy_idx;
+    if (!ms_tearfree_is_active_on_crtc(crtc) || ms->drmmode.dri2_flipping ||
+        ms->drmmode.present_flipping) {
+        ms_tearfree_copy_clear(crtc, TRUE);
+        return;
+    }
+
+    /* Allocate a DRM queue entry only now: a real kernel event will follow. */
+    seq = ms_drm_queue_alloc(crtc, crtc, ms_tearfree_flip_handler, ms_tearfree_flip_abort);
+    if (!seq)
+        FatalError("HDMI asynchronous TearFree could not allocate flip sequence\n");
+    if (do_queue_flip_on_crtc(screen, crtc, DRM_MODE_PAGE_FLIP_EVENT,
+                             seq, trf->buf[idx].fb_id, 0, 0))
+        FatalError("HDMI asynchronous TearFree flip submission failed\n");
+    trf->flip_seq = seq;
+    ms_tearfree_copy_clear(crtc, FALSE);
+    if (getenv("HDMI_LOS_TEARFREE_STATS") && GetTimeInMillis() - trf->stats_last_ms >= 1000) {
+        xf86DrvMsg(crtc->scrn->scrnIndex, X_INFO,
+                   "HDMI_ASYNC copies=%llu pixels=%llu export_us=%llu ready_us=%llu max_export_us=%llu max_ready_us=%llu\n",
+                   (unsigned long long)trf->copies, (unsigned long long)trf->pixels,
+                   (unsigned long long)trf->export_us, (unsigned long long)trf->ready_us,
+                   (unsigned long long)trf->max_export_us, (unsigned long long)trf->max_ready_us);
+        trf->stats_last_ms = GetTimeInMillis();
+        trf->copies = trf->pixels = trf->export_us = trf->ready_us = 0;
+        trf->max_export_us = trf->max_ready_us = 0;
+    }
+}
+
+static Bool
+ms_tearfree_start_copy(ScreenPtr screen, xf86CrtcPtr crtc)
+{
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    uint64_t elapsed;
+    BoxPtr boxes;
+    int i;
+    trf->copy_idx = trf->back_idx;
+    RegionInit(&trf->copy_damage, NULL, 0);
+    if (!RegionCopy(&trf->copy_damage, &trf->buf[trf->copy_idx].dmg))
+        FatalError("HDMI asynchronous TearFree could not snapshot damage\n");
+    RegionEmpty(&trf->buf[trf->copy_idx].dmg);
+    trf->copy_pending = TRUE;
+    trf->copy_started_us = GetTimeInMicros();
+    trf->copy_fd = drmmode_copy_damage_fence(crtc, trf->buf[trf->copy_idx].px, &trf->copy_damage);
+    trf->copy_exported_us = GetTimeInMicros();
+    if (trf->copy_fd < 0)
+        FatalError("HDMI asynchronous TearFree native-fence export failed\n");
+    elapsed = trf->copy_exported_us - trf->copy_started_us;
+    trf->export_us += elapsed;
+    if (elapsed > trf->max_export_us) trf->max_export_us = elapsed;
+    trf->copies++;
+    boxes = RegionRects(&trf->copy_damage);
+    for (i = 0; i < RegionNumRects(&trf->copy_damage); ++i)
+        trf->pixels += (uint64_t)(boxes[i].x2 - boxes[i].x1) * (boxes[i].y2 - boxes[i].y1);
+    if (!SetNotifyFd(trf->copy_fd, ms_tearfree_copy_ready, X_NOTIFY_READ, crtc))
+        FatalError("HDMI asynchronous TearFree could not register native-fence readiness\n");
+    trf->copy_timer = TimerSet(trf->copy_timer, 0, 2000, ms_tearfree_copy_timeout, crtc);
+    if (!trf->copy_timer)
+        FatalError("HDMI asynchronous TearFree could not arm recovery timeout\n");
+    return FALSE;
+}
