+Bool
+glamor_egl_native_fence_supported(ScreenPtr screen)
+{
+    struct glamor_egl_screen_private *egl =
+        glamor_egl_get_screen_private(xf86ScreenToScrn(screen));
+    return egl && egl->display != EGL_NO_DISPLAY &&
+           epoxy_has_egl_extension(egl->display, "EGL_ANDROID_native_fence_sync") &&
+           epoxy_has_egl_extension(egl->display, "EGL_KHR_fence_sync");
+}
+
+int
+glamor_egl_export_native_fence(ScreenPtr screen)
+{
+    struct glamor_egl_screen_private *egl =
+        glamor_egl_get_screen_private(xf86ScreenToScrn(screen));
+    struct glamor_screen_private *glamor = glamor_get_screen_private(screen);
+    EGLSyncKHR sync;
+    int fd;
+
+    if (!glamor_egl_native_fence_supported(screen))
+        return -1;
+    glamor_make_current(glamor);
+    sync = eglCreateSyncKHR(egl->display, EGL_SYNC_NATIVE_FENCE_ANDROID, NULL);
+    if (sync == EGL_NO_SYNC_KHR)
+        return -1;
+    /* Submit preceding rendering in this same context. Export can wait for
+     * CPU submission readiness, but never waits for GPU execution completion. */
+    glFlush();
+    fd = eglDupNativeFenceFDANDROID(egl->display, sync);
+    eglDestroySyncKHR(egl->display, sync);
+    if (fd >= 0 && fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
