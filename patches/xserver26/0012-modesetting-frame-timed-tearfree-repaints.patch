+/* Use the real last flip timestamp and mode period to choose the next copy
+ * deadline. A stale/future timestamp cannot seed a repaint timeline. Quantize
+ * down to milliseconds so the timer never deliberately consumes the reserve. */
+static unsigned
+ms_tearfree_repaint_delay(uint64_t last_ust, uint64_t now,
+                          uint64_t period, unsigned reserve)
+{
+    uint64_t remaining;
+    if (!reserve || !period || reserve >= period || !last_ust ||
+        now < last_ust || now - last_ust > 1000000)
+        return 0;
+    remaining = period - (now - last_ust) % period;
+    return remaining > reserve ? (remaining - reserve) / 1000 : 0;
+}
+
+static CARD32
+ms_tearfree_repaint_ready(OsTimerPtr timer, CARD32 now, void *data)
+{
+    xf86CrtcPtr crtc = data;
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    dc->tearfree.repaint_pending = FALSE;
+    dc->tearfree.repaint_ready = TRUE;
+    return 0;
+}
+
+Bool
+ms_tearfree_wait_repaint(xf86CrtcPtr crtc)
+{
+    drmmode_crtc_private_ptr dc = crtc->driver_private;
+    drmmode_tearfree_ptr trf = &dc->tearfree;
+    unsigned reserve = dc->drmmode->tearfree_repaint_us;
+    double refresh = xf86ModeVRefresh(&crtc->mode);
+    unsigned delay;
+
+    if (!dc->drmmode->tearfree_async || !reserve)
+        return FALSE;
+    if (trf->repaint_ready) {
+        trf->repaint_ready = FALSE;
+        return FALSE;
+    }
+    if (trf->repaint_pending)
+        return TRUE;
+    if (refresh <= 0)
+        return FALSE;
+    delay = ms_tearfree_repaint_delay(trf->last_flip_ust, GetTimeInMicros(),
+                                     (uint64_t)(1000000.0 / refresh), reserve);
+    if (!delay)
+        return FALSE;
+    trf->repaint_timer = TimerSet(trf->repaint_timer, 0, delay,
+                                 ms_tearfree_repaint_ready, crtc);
+    if (!trf->repaint_timer)
+        FatalError("HDMI TearFree could not schedule its repaint deadline\n");
+    trf->repaint_pending = TRUE;
+    return TRUE;
+}
