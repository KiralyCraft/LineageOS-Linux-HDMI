+/* Private KGSL/Mesa capability: standard FD replies follow producer completion. */
+#define DRI3_PRESENT_CAP_FENCE_GATED_EXPORT 0x08000000u
+extern _X_EXPORT Bool dri3_has_fd_export_fence(ScreenPtr screen);
+
+extern _X_EXPORT Bool
