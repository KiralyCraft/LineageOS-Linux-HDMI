# Root broker -> composer lease endpoint, and the user-installed QS tile -> broker.
allow magisk hal_graphics_composer_default unix_stream_socket connectto
allow magisk hal_graphics_composer_default fd use
allow untrusted_app magisk unix_stream_socket connectto
allow untrusted_app_32 magisk unix_stream_socket connectto

# The patched composer creates and serves an abstract SOCK_SEQPACKET socket.
allow hal_graphics_composer_default hal_graphics_composer_default unix_stream_socket { create bind listen accept read write getattr getopt setopt shutdown }
